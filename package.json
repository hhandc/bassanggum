{
  "name": "bassanggum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "lint": "pnpm typecheck",
    "typecheck": "pnpm build && tsc --noEmit --project tsconfig.base.json",
    "test": "pnpm build && vitest --config vitest.workspace.ts run",
    "build": "pnpm --recursive --if-present run build",
    "demo:data": "pnpm --filter @bassanggum/data-core run import:demo"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
